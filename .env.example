# Jambavan environment (optional; all values have defaults)
#
# Jambavan does NOT auto-load this file. Copy the variables you need into the
# MCP host's server environment, or export/source them before launching the host.
# This avoids importing arbitrary repository .env secrets into the MCP process.

# Absolute path to the project root Jambavan should index and serve.
# Default: auto-detected by walking up from cwd looking for package.json / .git
# JAMBAVAN_ROOT=/path/to/your/project

# Token budget for jambavan_context results.
# The context assembler hard-caps output to this many tokens.
# Default: 8000
# JAMBAVAN_TOKEN_BUDGET=8000

# Root-independent archive for memories and failure records.
# Default: ~/.jambavan/memory
# JAMBAVAN_MEMORY_HOME=/path/to/jambavan-memory

# Source mutation and shell are separate opt-ins. Enabling both raises the MCP
# surface from 20 tools by default to 24 tools.
# JAMBAVAN_ALLOW_WRITE=1
# JAMBAVAN_ALLOW_BASH=1
